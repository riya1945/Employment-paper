dout","text":"Resume Category Distribution:\nCategory\nINFORMATION-TECHNOLOGY    120\nBUSINESS-DEVELOPMENT      120\nENGINEERING               118\nADVOCATE                  118\nFINANCE                   118\nACCOUNTANT                118\nFITNESS                   117\nSALES                     116\nBANKING                   115\nHEALTHCARE                115\nCONSULTANT                115\nCONSTRUCTION              112\nHR                        110\nDESIGNER                  107\nTEACHER                   102\nDIGITAL-MEDIA              96\nAGRICULTURE                63\nName: count, dtype: int64\n\nJob Category Distribution:\nMapped_Category\nACCOUNTANT                9983\nENGINEERING               8092\nINFORMATION-TECHNOLOGY    7872\nSALES                     5898\nHR                        3714\nBANKING                   2362\nCONSTRUCTION              1283\nDESIGNER                   701\nHEALTHCARE                 677\nTEACHER                    602\nDIGITAL-MEDIA              333\nADVOCATE                   315\nCONSULTANT                 270\nFINANCE                    178\nBUSINESS-DEVELOPMENT        99\nAGRICULTURE                 78\nFITNESS                     30\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"resume_df_clean.to_csv(\"clean_resumes.csv\", index=False)\njob_df_clean.to_csv(\"clean_job_descriptions.csv\", index=False)","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:52:57.876917Z","iopub.execute_input":"2026-06-15T05:52:57.877442Z","iopub.status.idle":"2026-06-15T05:53:01.572918Z","shell.execute_reply.started":"2026-06-15T05:52:57.877416Z","shell.execute_reply":"2026-06-15T05:53:01.572289Z"},"trusted":true},"outputs":[],"execution_count":10},{"cell_type":"code","source":"import pandas as pd\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom collections import Counter\nimport re\n\n# Load cleaned files\nresume_df = pd.read_csv(\"clean_resumes.csv\")\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\n\nprint(resume_df.shape)\nprint(job_df.shape)\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:01.574012Z","iopub.execute_input":"2026-06-15T05:53:01.574358Z","iopub.status.idle":"2026-06-15T05:53:03.223312Z","shell.execute_reply.started":"2026-06-15T05:53:01.574332Z","shell.execute_reply":"2026-06-15T05:53:03.222421Z"},"trusted":true},"outputs":[{"name":"stdout","text":"(1880, 4)\n(42487, 3)\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"plt.figure()\nresume_df[\"Category\"].value_counts().plot(kind='bar')\nplt.title(\"Resume Category Distribution\")\nplt.xlabel(\"Category\")\nplt.ylabel(\"Count\")\nplt.xticks(rotation=90)\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:03.224669Z","iopub.execute_input":"2026-06-15T05:53:03.225054Z","iopub.status.idle":"2026-06-15T05:53:03.528715Z","shell.execute_reply.started":"2026-06-15T05:53:03.225012Z","shell.execute_reply":"2026-06-15T05:53:03.527996Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":12},{"cell_type":"code","source":"plt.figure()\njob_df[\"Mapped_Category\"].value_counts().plot(kind='bar')\nplt.title(\"Job Description Category Distribution\")\nplt.xlabel(\"Category\")\nplt.ylabel(\"Count\")\nplt.xticks(rotation=90)\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:03.529770Z","iopub.execute_input":"2026-06-15T05:53:03.530457Z","iopub.status.idle":"2026-06-15T05:53:03.712841Z","shell.execute_reply.started":"2026-06-15T05:53:03.530430Z","shell.execute_reply":"2026-06-15T05:53:03.712187Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":13},{"cell_type":"code","source":"resume_df[\"resume_length\"] = resume_df[\"Resume_str\"].apply(lambda x: len(str(x).split()))\n\nplt.figure()\nplt.hist(resume_df[\"resume_length\"], bins=50)\nplt.title(\"Resume Word Count Distribution\")\nplt.xlabel(\"Word Count\")\nplt.ylabel(\"Frequency\")\nplt.show()\n\nprint(\"Resume Avg Length:\", resume_df[\"resume_length\"].mean())\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:03.713749Z","iopub.execute_input":"2026-06-15T05:53:03.714095Z","iopub.status.idle":"2026-06-15T05:53:03.989990Z","shell.execute_reply.started":"2026-06-15T05:53:03.714044Z","shell.execute_reply":"2026-06-15T05:53:03.989306Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Resume Avg Length: 810.6021276595744\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"job_df[\"job_length\"] = job_df[\"descriptions\"].apply(lambda x: len(str(x).split()))\n\nplt.figure()\nplt.hist(job_df[\"job_length\"], bins=50)\nplt.title(\"Job Description Word Count Distribution\")\nplt.xlabel(\"Word Count\")\nplt.ylabel(\"Frequency\")\nplt.show()\n\nprint(\"Job Description Avg Length:\", job_df[\"job_length\"].mean())\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:03.990998Z","iopub.execute_input":"2026-06-15T05:53:03.991352Z","iopub.status.idle":"2026-06-15T05:53:04.963057Z","shell.execute_reply.started":"2026-06-15T05:53:03.991327Z","shell.execute_reply":"2026-06-15T05:53:04.962270Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Job Description Avg Length: 271.3068703368089\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"def clean_text(text):\n    text = str(text).lower()\n    text = re.sub(r'[^a-zA-Z\\s]', '', text)\n    return text\n\nall_resume_text = \" \".join(resume_df[\"Resume_str\"].apply(clean_text))\nword_counts = Counter(all_resume_text.split())\n\ncommon_words = word_counts.most_common(20)\n\nwords = [w[0] for w in common_words]\ncounts = [w[1] for w in common_words]\n\nplt.figure()\nplt.bar(words, counts)\nplt.title(\"Top 20 Resume Words\")\nplt.xticks(rotation=90)\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:04.964245Z","iopub.execute_input":"2026-06-15T05:53:04.964799Z","iopub.status.idle":"2026-06-15T05:53:05.786174Z","shell.execute_reply.started":"2026-06-15T05:53:04.964773Z","shell.execute_reply":"2026-06-15T05:53:05.785323Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":16},{"cell_type":"code","source":"all_job_text = \" \".join(job_df[\"descriptions\"].apply(clean_text))\njob_word_counts = Counter(all_job_text.split())\n\ncommon_job_words = job_word_counts.most_common(20)\n\nwords = [w[0] for w in common_job_words]\ncounts = [w[1] for w in common_job_words]\n\nplt.figure()\nplt.bar(words, counts)\nplt.title(\"Top 20 Job Description Words\")\nplt.xticks(rotation=90)\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:05.787371Z","iopub.execute_input":"2026-06-15T05:53:05.788007Z","iopub.status.idle":"2026-06-15T05:53:10.635811Z","shell.execute_reply.started":"2026-06-15T05:53:05.787978Z","shell.execute_reply":"2026-06-15T05:53:10.635176Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":17},{"cell_type":"code","source":"tfidf = TfidfVectorizer(max_features=1000, stop_words='english')\n\nresume_tfidf = tfidf.fit_transform(resume_df[\"Resume_str\"])\njob_tfidf = tfidf.transform(job_df[\"descriptions\"])\n\nprint(\"Resume TF-IDF shape:\", resume_tfidf.shape)\nprint(\"Job TF-IDF shape:\", job_tfidf.shape)\n","meta