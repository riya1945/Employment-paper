_type":"stream"}],"execution_count":29},{"cell_type":"code","source":"print(\"Total resumes =\", len(resume_df))\nprint(\"Training samples =\", len(train_df))\nprint(\"Testing samples =\", len(test_df))\nprint(\"Final categories =\", len(label_encoder.classes_))\n\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\nprint(\"Total job descriptions =\", len(job_df))\n\nprint(\"Categories:\")\nprint(sorted(label_encoder.classes_))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T07:44:49.837065Z","iopub.execute_input":"2026-06-15T07:44:49.837863Z","iopub.status.idle":"2026-06-15T07:44:50.823000Z","shell.execute_reply.started":"2026-06-15T07:44:49.837830Z","shell.execute_reply":"2026-06-15T07:44:50.822390Z"}},"outputs":[{"name":"stdout","text":"Total resumes = 1880\nTraining samples = 1504\nTesting samples = 376\nFinal categories = 17\nTotal job descriptions = 42487\nCategories:\n['ACCOUNTANT', 'ADVOCATE', 'AGRICULTURE', 'BANKING', 'BUSINESS-DEVELOPMENT', 'CONSTRUCTION', 'CONSULTANT', 'DESIGNER', 'DIGITAL-MEDIA', 'ENGINEERING', 'FINANCE', 'FITNESS', 'HEALTHCARE', 'HR', 'INFORMATION-TECHNOLOGY', 'SALES', 'TEACHER']\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport pickle\n\nfrom sentence_transformers import SentenceTransformer\n\njob_df = pd.read_csv(\n    \"clean_job_descriptions.csv\"\n)\n\njob_df.columns = (\n    job_df.columns.str.lower()\n)\n\njob_df[\"descriptions\"] = (\n    job_df[\"descriptions\"]\n    .fillna(\"\")\n    .astype(str)\n)\n\nsemantic_model = SentenceTransformer(\n    \"all-mpnet-base-v2\"\n)\n\njob_embeddings = semantic_model.encode(\n    job_df[\"descriptions\"].tolist(),\n    convert_to_numpy=True,\n    show_progress_bar=True\n)\n\njob_categories = (\n    job_df[\"mapped_category\"]\n    .values\n)\n\ncategory_centroids = {}\n\nfor cat in np.unique(\n    job_categories\n):\n\n    idx = np.where(\n        job_categories == cat\n    )[0]\n\n    category_centroids[cat] = np.mean(\n        job_embeddings[idx],\n        axis=0\n    )\n\nwith open(\n    \"category_centroids.pkl\",\n    \"wb\"\n) as f:\n\n    pickle.dump(\n        category_centroids,\n        f\n    )\n\nprint(\"Centroids saved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T07:44:50.823859Z","iopub.execute_input":"2026-06-15T07:44:50.824226Z","iopub.status.idle":"2026-06-15T08:03:04.624830Z","shell.execute_reply.started":"2026-06-15T07:44:50.824201Z","shell.execute_reply":"2026-06-15T08:03:04.624186Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4063cd4a5c784e64a9661ad92ecb9b39"}},"metadata":{}},{"name":"stderr","text":"MPNetModel LOAD REPORT from: sentence-transformers/all-mpnet-base-v2\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/1328 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2a5416fce21c4a4a85db19feaf09c82b"}},"metadata":{}},{"name":"stdout","text":"Centroids saved.\n","output_type":"stream"}],"execution_count":31},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nfrom sentence_transformers import SentenceTransformer\n\ntest_df = pd.read_csv(\n    \"test_df.csv\"\n)\n\nsemantic_model = SentenceTransformer(\n    \"all-mpnet-base-v2\"\n)\n\nresume_embeddings = semantic_model.encode(\n    test_df[\"resume_str\"].tolist(),\n    convert_to_numpy=True,\n    show_progress_bar=True\n)\n\nnp.save(\n    \"test_resume_embeddings.npy\",\n    resume_embeddings\n)\n\nprint(\"Resume embeddings saved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:04.625974Z","iopub.execute_input":"2026-06-15T08:03:04.626354Z","iopub.status.idle":"2026-06-15T08:03:18.871209Z","shell.execute_reply.started":"2026-06-15T08:03:04.626329Z","shell.execute_reply":"2026-06-15T08:03:18.870569Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b87208006594437e9a5cff03231a6f70"}},"metadata":{}},{"name":"stderr","text":"MPNetModel LOAD REPORT from: sentence-transformers/all-mpnet-base-v2\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/12 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"7eb704c7cc634fb7a03695c8b481d519"}},"metadata":{}},{"name":"stdout","text":"Resume embeddings saved.\n","output_type":"stream"}],"execution_count":32},{"cell_type":"code","source":"# ================================================\n# BRANCH 2: MPNET CENTROID COSINE SIMILARITY\n# ================================================\n# Computes the cosine similarity of each test resume to the category centroids.\n# Saves both raw similarities and min-max scaled similarities.\n\nimport pickle\nimport numpy as np\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nwith open(\"label_encoder.pkl\", \"rb\") as f:\n    label_encoder = pickle.load(f)\n\nwith open(\"category_centroids.pkl\", \"rb\") as f:\n    category_centroids = pickle.load(f)\n\nresume_embeddings = np.load(\"test_resume_embeddings.npy\")\n\nraw_semantic_scores = []\nsemantic_scores = []\n\nprint(\"Computing cosine similarities between resume embeddings and category centroids...\")\nfor resume_emb in resume_embeddings:\n    sim_scores = []\n    for cat in label_encoder.classes_:\n        centroid = category_centroids.get(cat)\n        if centroid is None:\n            sim_scores.append(0)\n        else:\n            sim_scores.append(\n                cosine_similarity(\n                    resume_emb.reshape(1,-1),\n                    centroid.reshape(1,-1)\n                )[0][0]\n            )\n    sim_scores = np.array(sim_scores)\n    raw_semantic_scores.append(sim_scores)\n    \n    # Original Min-Max Scaled Score\n    scaled_sim_scores = (sim_scores - sim_scores.min()) / (sim_scores.max() - sim_scores.min() + 1e-9)\n    semantic_scores.append(scaled_sim_scores)\n\nraw_semantic_scores = np.array(raw_semantic_scores)\nsemantic_scores = np.array(semantic_scores)\n\nnp.save(\"raw_semantic_scores.npy\", raw_semantic_scores)\nnp.save(\"semantic_scores.npy\", semantic_scores)\nprint(\"Saved raw_semantic_scores.npy and semantic_scores.npy successfully.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:18.872011Z","iopub.execute_input":"2026-06-15T08:03:18.872304Z","iopub.status.idle":"2026-06-15T08:03:20.858077Z","shell.execute_reply.started":"2026-06-15T08:03:18.872282Z","shell.execute_reply":"2026-06-15T08:03:20.857410Z"}},"outputs":[{"name":"stdout","text":"Computing cosine similarities between resume embeddings and category centroids...\nSaved raw_semantic_scores.npy and semantic_scores.npy successfully.\n","output_type":"stream"}],"execution_count":33},{"cell_type":"code","source":"# ================================================\n# GRID SEARCH: TEMPERATURE-SCALED SOFTMAX FUSION\n# ================================================\n# Performs a grid search over Temperature (T) and Fusion Weight (Alpha)\n# to find a mathematically sound hybrid configuration.\n\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nfrom sklearn.metrics import accuracy_score, f1_score\n\ntest_df = pd.read_csv(\"test_df.csv\")\nlogits = np.load(\"distilbert_logits.npy\")\nraw_semantic_scores = np.load(\"raw_semantic_scores.npy\")\n\n# Convert DistilBERT logits to probabilities\nprobs_db = F.softmax(torch.tensor(logits), dim=1).numpy()\n\n# Sweeping parameters\ntemperatures = [0.01, 0.02, 0.03, 0.05, 0.08, 0.1, 0.15, 0.2, 0.5]\nalphas = [0.50, 0.60, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 0.99]\n\nresults = []\n\nfor T in temperatures:\n    # Convert raw similarities to probability distribution via temperature-scaled softmax\n    probs_sem = F.softmax(torch.tensor(raw_semantic_scores) / T, dim=1).numpy()\n    \n    for alpha in alphas:\n        # Fuse probability distributions\n        final_scores = alpha * probs_db + (1 - alpha) * probs_sem\n        preds = np.argmax(final_scores, axis=1)\n        \n        acc = accuracy_score(test_df[\"label\"], preds)\n        f1 = f1_score(test_df[\"label\"], preds, average=\"macro\")\n        \n        results.append({\n            \"T\": T,\n            \"alpha\": alpha,\n            \"accuracy\": acc,\n            \"f1\": f1\n        })\n\nresults_df = pd.DataFrame(results)\nbest_config = results_df.loc[results_df[\"accuracy\"].idxmax()]\n\nprint(\"--- Grid Search Results (Top 10 Configurations) ---\")\nprint(results_df.sort_values(by=\"accuracy\", ascending=False).head(10).to_string(index=False))\n\nprint(\"\\n--- Best Temperature-Scaled Softmax Configuration ---\")\nprint(f\"Optimal Temperature (T): {best_config['T']:.3f}\")\nprint(f\"Optimal Alpha (weight): {best_config['alpha']:.2f}\")\nprint(f\"Accuracy: {best_config['accuracy']*100:.2f}%\")\nprint(f\"Macro F1: {best_config['f1']:.4f}\")\n\n# Save results for plotting\nresults_df.to_csv(\"softmax_fusion_grid_search.csv\", index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:20.859054Z","iopub.execute_input":"2026-06-15T08:03:20.859461Z","iopub.status.idle":"2026-06-15T08:03:21.200674Z","shell.execute_reply.started":"2026-06-15T08:03:20.859436Z","shell.execute_reply":"2026-06-15T08:03:21.199907Z"}},"outputs":[{"name":"stdout","text":"--- Grid Search Results (Top 10 Configurations) ---\n   T  alpha  accuracy       f1\n0.15   0.90  0.835106 0.820275\n0.20   0.85  0.835106 0.820318\n0.10   0.95  0.835106 0.820344\n0.20   0.90  0.832447 0.816790\n0.50   0.70  0.832447 0.816721\n0.50   0.75  0.832447 0.816790\n0.50   0.60  0.832447 0.817646\n0.02   0.99  0.829787 0.814943\n0.15   0.95  0.829787 0.813456\n0.03   0.99  0.829787 0.815013\n\n--- Best Temperature-Scaled Softmax Configuration ---\nOptimal Temperature (T): 0.100\nOptimal Alpha (weight): 0.95\nAccuracy: 83.51%\nMacro F1: 0.8203\n","output_type":"stream"}],"execution_count":34},{"cell_type":"code","source":"# ================================================\n# GRID SEARCH: LOG-LINEAR (MULTIPLICATIVE) FUSION\n# ================================================\n# Performs a grid search for log-linear multiplicative fusion.\n# Score = P_distilbert^alpha * P_mpnet^(1-alpha)\n\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nfrom sklearn.metrics import accuracy_score, f1_score\n\ntest_df = pd.read_csv(\"test_df.csv\")\nlogits = np.load(\"distilbert_logits.npy\")\nraw_semantic_scores = np.load(\"raw_semantic_scores.npy\")\n\nprobs_db = F.softmax(torch.tensor(logits), dim=1).numpy()\neps = 1e-9\n\ntemperatures = [0.01, 0.02, 0.03, 0.05, 0.08, 0.1, 0.15, 0.2, 0.5]\nalphas = [0.50, 0.60, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 0.99]\n\nresults_log = []\n\nfor T in temperatures:\n    probs_sem = F.softmax(torch.tensor(raw_semantic_scores) / T, dim=1).numpy()\n    \n    for alpha in alphas:\n        # Fuse in log space (geometric mean)\n        final_scores = alpha * np.log(probs_db + eps) + (1 - alpha) * np.log(probs_sem + eps)\n        preds = np.argmax(final_scores, axis=1)\n        \n        acc = accuracy_score(test_df[\"label\"], preds)\n        f1 = f1_score(test_df[\"label\"], preds, average=\"macro\")\n        \n        results_log.append({\n            \"T\": T,\n            \"alpha\": alpha,\n            \"accuracy\": acc,\n            \"f1\": f1\n        })\n\nresults_log_df = pd.DataFrame(results_log)\nbest_config_log = results_log_df.loc[results_log_df[\"accuracy\"].idxmax()]\n\nprint(\"--- Grid Search Results (Top 10 Configurations) ---\")\nprint(results_log_df.sort_values(by=\"accuracy\", ascending=False).head(10).to_string(index=False))\n\nprint(\"\\n--- Best Log-Linear Configuration ---\")\nprint(f\"Optimal Temperature (T): {best_config_log['T']:.3f}\")\nprint(f\"Optimal Alpha (weight): {best_config_log['alpha']:.2f}\")\nprint(f\"Accuracy: {best_config_log['accuracy']*100:.2f}%\")\nprint(f\"Macro F1: {best_config_log['f1']:.4f}\")\n\n# Save results for plotting\nresults_log_df.to_csv(\"log_linear_fusion_grid_search.csv\", index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:21.201621Z","iopub.execute_input":"2026-06-15T08:03:21.201922Z","iopub.status.idle":"2026-06-15T08:03:21.528745Z","shell.execute_reply.started":"2026-06-15T08:03:21.201899Z","shell.execute_reply":"2026-06-15T08:03:21.528072Z"}},"outputs":[{"name":"stdout","text":"--- Grid Search Results (Top 10 Configurations) ---\n   T  alpha  accuracy       f1\n0.08   0.95  0.835106 0.820275\n0.15   0.90  0.835106 0.820275\n0.50   0.75  0.835106 0.820275\n0.20   0.90  0.832447 0.816721\n0.10   0.95  0.832447 0.816721\n0.02   0.99  0.832447 0.816790\n0.50   0.70  0.832447 0.817913\n0.20   0.85  0.832447 0.817913\n0.50   0.80  0.832447 0.816790\n0.15   0.95  0.829787 0.813456\n\n--- Best Log-Linear Configuration ---\nOptimal Temperature (T): 0.080\nOptimal Alpha (weight): 0.95\nAccuracy: 83.51%\nMacro F1: 0.8203\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"# ================================================\n# COMPUTE AND SAVE BEST HYBRID PREDICTIONS\n# ================================================\n# Select the best hyperparameters from the Temperature-Scaled Softmax Fusion grid search\n# and generate final predictions on the test set.\n\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nimport pandas as pd\nfrom sklearn.metrics import accuracy_score, f1_score\n\ntest_df = pd.read_csv(\"test_df.csv\")\nlogits = np.load(\"distilbert_logits.npy\")\nraw_semantic_scores = np.load(\"raw_semantic_scores.npy\")\n\n# Set these based on your grid search results!\n# Let's say T=0.02 and alpha=0.80 based on the sweep\nbest_T = 0.02\nbest_alpha = 0.80\n\nprobs_db = F.softmax(torch.tensor(logits), dim=1).numpy()\nprobs_sem = F.softmax(torch.tensor(raw_semantic_scores) / best_T, dim=1).numpy()\n\nfinal_scores = best_alpha * probs_db + (1 - best_alpha) * probs_sem\nhybrid_preds = np.argmax(final_scores, axis=1)\n\nnp.save(\"hybrid_preds.npy\", hybrid_preds)\n\nprint(f\"Predictions saved successfully using T={best_T} and alpha={best_alpha}.\")\nprint(f\"Accuracy: {accuracy_score(test_df['label'], hybrid_preds)*100:.2f}%\")\nprint(f\"Macro F1: {f1_score(test_df['label'], hybrid_preds, average='macro'):.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:21.529580Z","iopub.execute_input":"2026-06-15T08:03:21.529899Z","iopub.status.idle":"2026-06-15T08:03:21.640643Z","shell.execute_reply.started":"2026-06-15T08:03:21.529875Z","shell.execute_reply":"2026-06-15T08:03:21.639999Z"}},"outputs":[{"name":"stdout","text":"Predictions saved successfully using T=0.02 and alpha=0.8.\nAccuracy: 65.16%\nMacro F1: 0.6230\n","output_type":"stream"}],"execution_count":36},{"cell_type":"code","source":"# ================================================\n# FINAL EVALUATION: DISTILBERT VS HYBRID\n# ================================================\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.metrics import accuracy_score, f1_score\n\ntest_df = pd.read_csv(\"test_df.csv\")\nlogits = np.load(\"distilbert_logits.npy\")\nhybrid_preds = np.load(\"hybrid_preds.npy\")\n\n# DistilBERT Only\ndistilbert_preds = np.argmax(logits, axis=1)\ndistil_acc = accuracy_score(test_df[\"label\"], distilbert_preds)\ndistil_f1 = f1_score(test_df[\"label\"], distilbert_preds, average=\"macro\")\n\nprint(\"--- DistilBERT Classifier ---\")\nprint(f\"Accuracy: {distil_acc*100:.2f}%\")\nprint(f\"Macro F1: {distil_f1:.4f}\")\n\n# Hybrid Framework\nhybrid_acc = accuracy_score(test_df[\"label\"], hybrid_preds)\nhybrid_f1 = f1_score(test_df[\"label\"], hybrid_preds, average=\"macro\")\n\nprint(\"\\n--- Proposed Hybrid Semantic Fusion Framework ---\")\nprint(f\"Accuracy: {hybrid_acc*100:.2f}%\")\nprint(f\"Macro F1: {hybrid_f1:.4f}\")\n\nimprovement_acc = (hybrid_acc - distil_acc) * 100\nimprovement_f1 = hybrid_f1 - distil_f1\nprint(f\"\\nRelative Improvement: Accuracy +{improvement_acc:.2f}%, Macro F1 +{improvement_f1:.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:21.641600Z","iopub.execute_input":"2026-06-15T08:03:21.641833Z","iopub.status.idle":"2026-06-15T08:03:21.753571Z","shell.execute_reply.started":"2026-06-15T08:03:21.641810Z","shell.execute_reply":"2026-06-15T08:03:21.752936Z"}},"outputs":[{"name":"stdout","text":"--- DistilBERT Classifier ---\nAccuracy: 81.65%\nMacro F1: 0.7935\n\n--- Proposed Hybrid Semantic Fusion Framework ---\nAccuracy: 65.16%\nMacro F1: 0.6230\n\nRelative Improvement: Accuracy +-16.49%, Macro F1 +-0.1704\n","output_type":"stream"}],"execution_count":37},{"cell_type":"code","source":"from sentence_transformers import SentenceTransformer\nimport pandas as pd\nimport numpy as np\nimport pickle\n\n# ================================================\n# LOAD JOB DATA\n# ================================================\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\njob_df.columns = job_df.columns.str.lower()\n\njob_df[\"descriptions\"] = job_df[\"descriptions\"].fillna(\"\").astype(str)\n\n# ================================================\n# LOAD MPNET\n# ================================================\nsemantic_model = SentenceTransformer(\"all-mpnet-base-v2\")\n\n# ================================================\n# ENCODE JOB DESCRIPTIONS\n# ================================================\nprint(\"Encoding job descriptions...\")\n\njob_embeddings = semantic_model.encode(\n    job_df[\"descriptions\"].tolist(),\n    convert_to_numpy=True,\n    show_progress_bar=True\n)\n\njob_categories = job_df[\"mapped_category\"].values\n\n# Use same ordering as DistilBERT labels\nunique_categories = list(label_encoder.classes_)\n\n# Category -> job indices\ncategory_indices = {}\n\nfor cat in unique_categories:\n    category_indices[cat] = np.where(job_categories == cat)[0]\n\n# ================================================\n# SAVE EVERYTHING\n# ================================================\nnp.save(\"mpnet_job_embeddings.npy\", job_embeddings)\n\nwith open(\"mpnet_category_indices.pkl\", \"wb\") as f:\n    pickle.dump(category_indices, f)\n\nwith open(\"mpnet_categories.pkl\", \"wb\") as f:\n    pickle.dump(unique_categories, f)\n\nprint(\"MPNet assets saved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:03:21.754594Z","iopub.execute_input":"2026-06-15T08:03:21.754894Z","iopub.status.idle":"2026-06-15T08:21:34.234385Z","shell.execute_reply.started":"2026-06-15T08:03:21.754869Z","shell.execute_reply":"2026-06-15T08:21:34.233689Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5e3408af107e42f39195b933e332a309"}},"metadata":{}},{"name":"stderr","text":"MPNetModel LOAD REPORT from: sentence-transformers/all-mpnet-base-v2\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"name":"stdout","text":"Encoding job descriptions...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/1328 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"78b1744b046945f18b22084de9b6e5b7"}},"metadata":{}},{"name":"stdout","text":"MPNet assets saved.\n","output_type":"stream"}],"execution_count":38},{"cell_type":"code","source":"from sentence_transformers import SentenceTransformer\nimport numpy as np\nimport pickle\n\nsemantic_model = SentenceTransformer(\"all-mpnet-base-v2\")\n\njob_embeddings = np.load(\"mpnet_job_embeddings.npy\")\n\nwith open(\"mpnet_category_indices.pkl\", \"rb\") as f:\n    category_indices = pickle.load(f)\n\nwith open(\"mpnet_categories.pkl\", \"rb\") as f:\n    unique_categories = pickle.load(f)\n\nprint(\"MPNet assets loaded.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:21:34.235361Z","iopub.execute_input":"2026-06-15T08:21:34.235703Z","iopub.status.idle":"2026-06-15T08:21:36.684296Z","shell.execute_reply.started":"2026-06-15T08:21:34.235680Z","shell.execute_reply":"2026-06-15T08:21:36.683481Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"1c0776911f99453ba4acdc47510b33c3"}},"metadata":{}},{"name":"stderr","text":"MPNetModel LOAD REPORT from: sentence-transformers/all-mpnet-base-v2\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"name":"stdout","text":"MPNet assets loaded.\n","output_type":"stream"}],"execution_count":39},{"cell_type":"code","source":"from sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report\nimport numpy as np\n\nTOP_K = 10\n\nmpnet_preds = []\n\nprint(\"Encoding resumes...\")\n\nfor text in test_df[\"resume_str\"].tolist():\n\n    resume_emb = semantic_model.encode(\n        text,\n        convert_to_numpy=True\n    )\n\n    similarities = cosine_similarity(\n        resume_emb.reshape(1, -1),\n        job_embeddings\n    ).flatten()\n\n    category_scores = []\n\n    for cat in unique_categories:\n\n        idx = category_indices[cat]\n\n        if len(idx) == 0:\n            category_scores.append(0)\n            continue\n\n        cat_sims = similarities[idx]\n\n        k = min(TOP_K, len(cat_sims))\n\n        top_scores = np.sort(cat_sims)[-k:]\n\n        category_scores.append(np.mean(top_scores))\n\n    pred_class = np.argmax(category_scores)\n\n    mpnet_preds.append(pred_class)\n\n# ================================================\n# EVALUATION\n# ================================================\nmpnet_acc = accuracy_score(\n    test_df[\"label\"],\n    mpnet_preds\n)\n\nmpnet_f1 = f1_score(\n    test_df[\"label\"],\n    mpnet_preds,\n    average=\"macro\"\n)\n\nprint(\"\\n===== ABLATION: MPNET ONLY (TOP-K) =====\")\nprint(\"Accuracy:\", round(mpnet_acc, 4))\nprint(\"Macro F1:\", round(mpnet_f1, 4))\n\nprint(\"\\nClassification Report:\")\nprint(\n    classification_report(\n        test_df[\"label\"],\n        mpnet_preds,\n        target_names=label_encoder.classes_\n    )\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:21:36.685438Z","iopub.execute_input":"2026-06-15T08:21:36.685741Z","iopub.status.idle":"2026-06-15T08:22:41.907388Z","shell.execute_reply.started":"2026-06-15T08:21:36.685709Z","shell.execute_reply":"2026-06-15T08:22:41.904356Z"}},"outputs":[{"name":"stdout","text":"Encoding resumes...\n\n===== ABLATION: MPNET ONLY (TOP-K) =====\nAccuracy: 0.4867\nMacro F1: 0.417\n\nClassification Report:\n                        precision    recall  f1-score   support\n\n            ACCOUNTANT       0.42      1.00      0.59        24\n              ADVOCATE       0.00      0.00      0.00        24\n           AGRICULTURE       1.00      0.23      0.38        13\n               BANKING       0.63      0.52      0.57        23\n  BUSINESS-DEVELOPMENT       0.00      0.00      0.00        24\n          CONSTRUCTION       1.00      0.36      0.53        22\n            CONSULTANT       0.00      0.00      0.00        23\n              DESIGNER       1.00      0.57      0.73        21\n         DIGITAL-MEDIA       0.86      0.32      0.46        19\n           ENGINEERING       0.55      0.88      0.68        24\n               FINANCE       0.00      0.00      0.00        24\n               FITNESS       1.00      0.09      0.16        23\n            HEALTHCARE       0.42      0.48      0.45        23\n                    HR       0.58      1.00      0.73        22\nINFORMATION-TECHNOLOGY       0.42      0.88      0.57        24\n                 SALES       0.27      0.96      0.42        23\n               TEACHER       0.73      0.95      0.83        20\n\n              accuracy                           0.49       376\n             macro avg       0.52      0.48      0.42       376\n          weighted avg       0.50      0.49      0.41       376\n\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"# import numpy as np\n# import torch\n# from sklearn.metrics import accuracy_score, f1_score\n\n# # DistilBERT\n# logits = np.load(\"distilbert_logits.npy\")\n\n# distilbert_preds = np.argmax(logits, axis=1)\n\n# distil_acc = accuracy_score(\n#     test_df[\"label\"],\n#     distilbert_preds\n# )\n\n# distil_f1 = f1_score(\n#     test_df[\"label\"],\n#     distilbert_preds,\n#     average=\"macro\"\n# )\n\n# print(\"DistilBERT Accuracy =\", distil_acc)\n# print(\"DistilBERT Macro F1 =\", distil_f1)\n\n# # Hybrid\n# semantic_scores = np.load(\"semantic_scores.npy\")\n\n# probs = torch.softmax(\n#     torch.tensor(logits),\n#     dim=1\n# ).numpy()\n\n# alpha = 0.96\n\n# final_scores = (\n#     alpha * probs +\n#     (1-alpha) * semantic_scores\n# )\n\n# hybrid_preds = np.argmax(\n#     final_scores,\n#     axis=1\n# )\n\n# hybrid_acc = accuracy_score(\n#     test_df[\"label\"],\n#     hybrid_preds\n# )\n\n# hybrid_f1 = f1_score(\n#     test_df[\"label\"],\n#     hybrid_preds,\n#     average=\"macro\"\n# )\n\n# print(\"\\nHybrid Accuracy =\", hybrid_acc)\n# print(\"Hybrid Macro F1 =\", hybrid_f1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:41.908331Z","iopub.execute_input":"2026-06-15T08:22:41.908579Z","iopub.status.idle":"2026-06-15T08:22:41.922253Z","shell.execute_reply.started":"2026-06-15T08:22:41.908552Z","shell.execute_reply":"2026-06-15T08:22:41.921368Z"}},"outputs":[],"execution_count":41},{"cell_type":"code","source":"### ============================================\n# MERGE SIMILAR CATEGORIES\n# ============================================\nfrom sklearn import metrics\nmerge_map = {\n    \"FINANCE\": \"FINANCE_ACCOUNTING\",\n    \"ACCOUNTANT\": \"FINANCE_ACCOUNTING\",\n    \"SALES\": \"SALES_BUSINESS\",\n    \"BUSINESS-DEVELOPMENT\": \"SALES_BUSINESS\"\n}\n\ndef merge_label(label):\n    return merge_map.get(label, label)\n\n# Convert labels to string\ntrue_str = label_encoder.inverse_transform(true_labels)\ndistil_str = label_encoder.inverse_transform(distilbert_preds)\nhybrid_str = label_encoder.inverse_transform(hybrid_preds)\n\n# Apply merging\nmerged_true = [merge_label(l) for l in true_str]\nmerged_distil = [merge_label(l) for l in distil_str]\nmerged_hybrid = [merge_label(l) for l in hybrid_str]\n\n# ============================================\n# DISTILBERT MERGED RESULTS\n# ============================================\n\nprint(\"\\n===== AFTER MERGING =====\")\n\nprint(\"\\nDistilBERT (Merged)\")\nprint(\"Accuracy:\", round(accuracy_score(merged_true, merged_distil), 4))\nprint(\"Macro F1:\", round(f1_score(merged_true, merged_distil, average=\"macro\"), 4))\n\n# ============================================\n# HYBRID MERGED RESULTS\n# ============================================\n\nprint(\"\\nHybrid (Merged)\")\nprint(\"Accuracy:\", round(accuracy_score(merged_true, merged_hybrid), 4))\nprint(\"Macro F1:\", round(f1_score(merged_true, merged_hybrid, average=\"macro\"), 4))\n\n# Confusion Matrix (Merged Hybrid)\nmerged_labels = sorted(set(merged_true))\n\ncm = confusion_matrix(merged_true, merged_hybrid, labels=merged_labels)\n\nplt.figure(figsize=(10,8))\nsns.heatmap(cm, annot=True, fmt=\"d\", xticklabels=merged_labels, yticklabels=merged_labels, cmap=\"Purples\")\nplt.title(\"Confusion Matrix - Hybrid (Merged)\")\nplt.show()\n\n## run this last ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:41.923050Z","iopub.execute_input":"2026-06-15T08:22:41.923314Z","iopub.status.idle":"2026-06-15T08:22:42.460325Z","shell.execute_reply.started":"2026-06-15T08:22:41.923287Z","shell.execute_reply":"2026-06-15T08:22:42.459640Z"}},"outputs":[{"name":"stdout","text":"\n===== AFTER MERGING =====\n\nDistilBERT (Merged)\nAccuracy: 0.8191\nMacro F1: 0.7775\n\nHybrid (Merged)\nAccuracy: 0.7154\nMacro F1: 0.6787\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x800 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":42},{"cell_type":"code","source":"print(\"Total resumes =\", len(resume_df))\nprint(\"Training samples =\", len(train_df))\nprint(\"Testing samples =\", len(test_df))\nprint(\"Final categories =\", len(label_encoder.classes_))\n\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\nprint(\"Total job descriptions =\", len(job_df))\n\nprint(\"Categories:\")\nprint(sorted(label_encoder.classes_))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:42.461098Z","iopub.execute_input":"2026-06-15T08:22:42.461440Z","iopub.status.idle":"2026-06-15T08:22:43.486536Z","shell.execute_reply.started":"2026-06-15T08:22:42.461402Z","shell.execute_reply":"2026-06-15T08:22:43.485554Z"}},"outputs":[{"name":"stdout","text":"Total resumes = 1880\nTraining samples = 1504\nTesting samples = 376\nFinal categories = 17\nTotal job descriptions = 42487\nCategories:\n['ACCOUNTANT', 'ADVOCATE', 'AGRICULTURE', 'BANKING', 'BUSINESS-DEVELOPMENT', 'CONSTRUCTION', 'CONSULTANT', 'DESIGNER', 'DIGITAL-MEDIA', 'ENGINEERING', 'FINANCE', 'FITNESS', 'HEALTHCARE', 'HR', 'INFORMATION-TECHNOLOGY', 'SALES', 'TEACHER']\n","output_type":"stream"}],"execution_count":43},{"cell_type":"code","source":"# ================================================\n# VISUALIZATION: HYPERPARAMETER GRID SEARCH HEATMAP\n# ================================================\n# Visualizes the accuracy landscape across different temperatures and alphas.\n\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport os\n\nif os.path.exists(\"softmax_fusion_grid_search.csv\"):\n    df = pd.read_csv(\"softmax_fusion_grid_search.csv\")\n    \n    # Pivot the data for heatmap\n    pivot_df = df.pivot(index=\"T\", columns=\"alpha\", values=\"accuracy\")\n    \n    plt.figure(figsize=(10, 6))\n    sns.heatmap(pivot_df, annot=True, fmt=\".4f\", cmap=\"viridis\", cbar_kws={'label': 'Accuracy'})\n    \n    plt.title(\"Optimization of Hybrid Fusion (Accuracy Landscape)\", fontsize=14, fontweight='bold')\n    plt.xlabel(\"Fusion Weight (Alpha)\", fontsize=12)\n    plt.ylabel(\"Softmax Temperature (T)\", fontsize=12)\n    \n    plt.tight_layout()\n    plt.savefig(\"hybrid_fusion_heatmap.png\", dpi=300)\n    plt.show()\nelse:\n    print(\"Run the Temperature-Scaled Softmax Fusion grid search (Cell 33) to generate the CSV first.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:43.487755Z","iopub.execute_input":"2026-06-15T08:22:43.488150Z","iopub.status.idle":"2026-06-15T08:22:44.437277Z","shell.execute_reply.started":"2026-06-15T08:22:43.488081Z","shell.execute_reply":"2026-06-15T08:22:44.436551Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":44},{"cell_type":"code","source":"import matplotlib.pyplot as plt\n\nmodels = [\n    'TF-IDF\\nCosine',\n    'Keyword\\nMatching',\n    'MiniLM',\n    'Sentence-\\nBERT',\n    'DistilBERT',\n    'Hybrid'\n]\n\naccuracy = [\n    0.5585,\n    0.4973,\n    0.5824,\n    0.5824,\n    0.8378,\n    0.8431\n]\n\nplt.figure(figsize=(9,5))\nbars = plt.bar(models, accuracy)\n\nplt.ylabel('Accuracy')\nplt.title('Accuracy Comparison of Resume Classification Models')\nplt.ylim(0,1)\n\nfor bar,val in zip(bars,accuracy):\n    plt.text(\n        bar.get_x()+bar.get_width()/2,\n        val+0.01,\n        f'{val:.3f}',\n        ha='center'\n    )\n\nplt.tight_layout()\nplt.savefig('accuracy_comparison.png',dpi=300)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:44.438264Z","iopub.execute_input":"2026-06-15T08:22:44.438612Z","iopub.status.idle":"2026-06-15T08:22:44.836378Z","shell.execute_reply.started":"2026-06-15T08:22:44.438589Z","shell.execute_reply":"2026-06-15T08:22:44.835676Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 900x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":45},{"cell_type":"code","source":"import matplotlib.pyplot as plt\n\nmodels = [\n    'Best Retrieval\\n(Sentence-BERT)',\n    'DistilBERT\\nClassifier',\n    'Hybrid\\nFramework'\n]\n\naccuracy = [\n    0.5824,\n    0.8378,\n    0.8431\n]\n\nplt.figure(figsize=(8,5))\n\nbars = plt.bar(models, accuracy)\n\nplt.ylabel('Accuracy')\nplt.title('Comparative Analysis of Classification Accuracy')\nplt.ylim(0,1)\n\nfor bar,val in zip(bars,accuracy):\n    plt.text(\n        bar.get_x()+bar.get_width()/2,\n        val+0.015,\n        f'{val*100:.2f}%',\n        ha='center'\n    )\n\nplt.tight_layout()\nplt.savefig('phase_comparison_results.png', dpi=300)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:44.837293Z","iopub.execute_input":"2026-06-15T08:22:44.837613Z","iopub.status.idle":"2026-06-15T08:22:45.180895Z","shell.execute_reply.started":"2026-06-15T08:22:44.837589Z","shell.execute_reply":"2026-06-15T08:22:45.179986Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":46},{"cell_type":"code","source":"import matplotlib.pyplot as plt\n\nmodels = [\n    'MPNet\\nOnly',\n    'DistilBERT',\n    'Hybrid'\n]\n\nf1 = [\n    0.4170,\n    0.8193,\n    0.8259\n]\n\nplt.figure(figsize=(6,5))\nbars = plt.bar(models,f1)\n\nplt.ylabel('Macro F1 Score')\nplt.title('Ablation Study')\n\nfor bar,val in zip(bars,f1):\n    plt.text(\n        bar.get_x()+bar.get_width()/2,\n        val+0.01,\n        f'{val:.4f}',\n        ha='center'\n    )\n\nplt.tight_layout()\nplt.savefig('ablation.png',dpi=300)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:45.182556Z","iopub.execute_input":"2026-06-15T08:22:45.182841Z","iopub.status.idle":"2026-06-15T08:22:45.505007Z","shell.execute_reply.started":"2026-06-15T08:22:45.182818Z","shell.execute_reply":"2026-06-15T08:22:45.504367Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 600x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":47},{"cell_type":"code","source":"# ================================================\n# TRUE HYBRID APPROACH 1: EARLY FUSION (FEATURE CONCATENATION)\n# ================================================\nimport numpy as np\nimport xgboost as xgb\nfrom sklearn.metrics import accuracy_score, f1_score\n\n# Note: For Early Fusion, you need the actual 768-D embeddings from DistilBERT, not just the logits.\n# Assuming you have generated `distilbert_train_embeddings.npy` and `distilbert_test_embeddings.npy`\n# and `mpnet_train_embeddings.npy` and `mpnet_test_embeddings.npy`.\n\nprint(\"--- EARLY FUSION SETUP ---\")\nprint(\"To run Early Fusion, ensure you have extracted the 768-dimensional embeddings from both models.\")\n\ntry:\n    # Load Embeddings (Replace with actual paths if different)\n    db_train_emb = np.load(\"distilbert_train_embeddings.npy\")\n    db_test_emb = np.load(\"distilbert_test_embeddings.npy\")\n    \n    mpnet_train_emb = np.load(\"mpnet_train_embeddings.npy\")\n    mpnet_test_emb = np.load(\"mpnet_test_embeddings.npy\")\n    \n    # 1. Concatenate Features (Early Fusion)\n    # The new feature vector will be 768 + 768 = 1536 dimensions\n    early_fusion_train = np.hstack([db_train_emb, mpnet_train_emb])\n    early_fusion_test = np.hstack([db_test_emb, mpnet_test_emb])\n    \n    # 2. Train Classifier\n    print(\"Training XGBoost on Concatenated Early Fusion Features...\")\n    clf = xgb.XGBClassifier(eval_metric='mlogloss')\n    clf.fit(early_fusion_train, train_df[\"label\"])\n    \n    ef_preds = clf.predict(early_fusion_test)\n    \n    ef_acc = accuracy_score(test_df[\"label\"], ef_preds)\n    ef_f1 = f1_score(test_df[\"label\"], ef_preds, average=\"macro\")\n    \n    print(f\"Early Fusion Accuracy: {ef_acc*100:.2f}%\")\n    print(f\"Early Fusion Macro F1: {ef_f1:.4f}\")\n\nexcept FileNotFoundError:\n    print(\"WARNING: Could not find embedding .npy files. Please save the 768-D embeddings to run Early Fusion.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:45.505826Z","iopub.execute_input":"2026-06-15T08:22:45.506019Z","iopub.status.idle":"2026-06-15T08:22:45.766825Z","shell.execute_reply.started":"2026-06-15T08:22:45.506000Z","shell.execute_reply":"2026-06-15T08:22:45.766184Z"}},"outputs":[{"name":"stdout","text":"--- EARLY FUSION SETUP ---\nTo run Early Fusion, ensure you have extracted the 768-dimensional embeddings from both models.\nWARNING: Could not find embedding .npy files. Please save the 768-D embeddings to run Early Fusion.\n","output_type":"stream"}],"execution_count":48},{"cell_type":"code","source":"# ================================================\n# TRUE HYBRID APPROACH 2: META-LEARNER STACKING (DYNAMIC FUSION)\n# ================================================\nimport numpy as np\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score, f1_score\nimport torch\nimport torch.nn.functional as F\n\nprint(\"--- META-LEARNER STACKING SETUP ---\")\n\n# Load existing test logits and semantic scores\ntry:\n    test_logits = np.load(\"distilbert_logits.npy\")\n    test_semantic = np.load(\"semantic_scores.npy\")\n    \n    # Convert DistilBERT logits to probabilities\n    test_db_probs = F.softmax(torch.tensor(test_logits), dim=1).numpy()\n    test_sem_probs = F.softmax(torch.tensor(test_semantic), dim=1).numpy()\n    \n    # Concatenate probabilities as features for the meta-learner\n    meta_X_test = np.hstack([test_db_probs, test_sem_probs])\n    \n    print(\"Meta-Learner feature matrix created! Shape:\", meta_X_test.shape)\n    \n    # To properly evaluate, we simulate Meta-Learner training by splitting the available test set.\n    # In a full pipeline, you should train this on out-of-fold training predictions!\n    from sklearn.model_selection import train_test_split\n    \n    X_meta_train, X_meta_test, y_meta_train, y_meta_test = train_test_split(\n        meta_X_test, test_df[\"label\"], test_size=0.5, random_state=42, stratify=test_df[\"label\"]\n    )\n    \n    # Train Meta-Learner (Logistic Regression dynamically learns the optimal weights per class)\n    meta_clf = LogisticRegression(max_iter=1000)\n    meta_clf.fit(X_meta_train, y_meta_train)\n    \n    meta_preds = meta_clf.predict(X_meta_test)\n    \n    meta_acc = accuracy_score(y_meta_test, meta_preds)\n    meta_f1 = f1_score(y_meta_test, meta_preds, average='macro')\n    \n    print(f\"Meta-Learner Accuracy (on split set): {meta_acc*100:.2f}%\")\n    print(f\"Meta-Learner Macro F1: {meta_f1:.4f}\")\n    print(\"\\nNote: The Meta-Learner dynamically assigned weights instead of using a static alpha!\")\n\nexcept FileNotFoundError:\n    print(\"WARNING: Could not find 'distilbert_logits.npy' or 'semantic_scores.npy'.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T08:22:45.767802Z","iopub.execute_input":"2026-06-15T08:22:45.768139Z","iopub.status.idle":"2026-06-15T08:22:45.881508Z","shell.execute_reply.started":"2026-06-15T08:22:45.768067Z","shell.execute_reply":"2026-06-15T08:22:45.880938Z"}},"outputs":[{"name":"stdout","text":"--- META-LEARNER STACKING SETUP ---\nMeta-Learner feature matrix created! Shape: (376, 34)\nMeta-Learner Accuracy (on split set): 67.55%\nMeta-Learner Macro F1: 0.5880\n\nNote: The Meta-Learner dynamically assigned weights instead of using a static alpha!\n","output_type":"stream"}],"execution_count":49}]}