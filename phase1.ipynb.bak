<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"690d38c742d44feb9e8971c4debde21e"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8b4a5e8f8db24595acdcc621505465a7"}},"metadata":{}},{"name":"stdout","text":"Encoding job descriptions...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 42487/42487 [23:39<00:00, 29.93it/s]\n","output_type":"stream"},{"name":"stdout","text":"Job Embedding Shape: (42487, 768)\nEvaluating semantic model...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 376/376 [01:22<00:00,  4.57it/s]\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n","output_type":"stream"},{"name":"stdout","text":"\nImproved Semantic Matching (Sentence-BERT)\nAccuracy: 0.516\nMacro F1: 0.4559\n\nClassification Report:\n                        precision    recall  f1-score   support\n\n            ACCOUNTANT       0.43      0.96      0.60        24\n              ADVOCATE       0.00      0.00      0.00        24\n           AGRICULTURE       1.00      0.31      0.47        13\n               BANKING       0.74      0.61      0.67        23\n  BUSINESS-DEVELOPMENT       0.00      0.00      0.00        24\n          CONSTRUCTION       0.89      0.36      0.52        22\n            CONSULTANT       0.00      0.00      0.00        23\n              DESIGNER       0.86      0.57      0.69        21\n         DIGITAL-MEDIA       0.90      0.47      0.62        19\n           ENGINEERING       0.52      0.92      0.67        24\n               FINANCE       0.00      0.00      0.00        24\n               FITNESS       1.00      0.35      0.52        23\n            HEALTHCARE       0.38      0.57      0.46        23\n                    HR       0.67      1.00      0.80        22\nINFORMATION-TECHNOLOGY       0.42      0.88      0.57        24\n                 SALES       0.30      0.83      0.44        23\n               TEACHER       0.61      0.95      0.75        20\n\n              accuracy                           0.52       376\n             macro avg       0.51      0.52      0.46       376\n          weighted avg       0.49      0.52      0.45       376\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":27},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report, confusion_matrix\n\n# =====================================================\n# 0. Make sure model and chunk_text are loaded from previous cell\n# =====================================================\n# model = SentenceTransformer(\"all-mpnet-base-v2\", device=device)\n# def chunk_text(text, chunk_size=400, overlap=50): ...\n# def encode_long_text(text): ...\n\n# =====================================================\n# 0. Define get_embeddings to safely handle long texts\n# =====================================================\ndef get_embeddings(texts):\n    embeddings = []\n    for t in texts:\n        chunks = chunk_text(t)\n        if len(chunks) == 0:\n            emb = model.encode(str(t), convert_to_numpy=True)\n        else:\n            chunk_embs = model.encode(chunks, convert_to_numpy=True, show_progress_bar=False)\n            if chunk_embs.ndim == 1:\n                emb = chunk_embs\n            else:\n                emb = np.mean(chunk_embs, axis=0)\n        embeddings.append(emb)\n    return np.vstack(embeddings)\n\n# =====================================================\n# 1. TF-IDF REPRESENTATIONS\n# =====================================================\ntfidf = TfidfVectorizer(\n    max_features=5000,\n    stop_words='english',\n    ngram_range=(1,2)\n)\n\ncombined_corpus = list(train_resumes[\"resume_str\"]) + list(job_df[\"descriptions\"])\ntfidf.fit(combined_corpus)\n\ntest_tfidf = tfidf.transform(test_resumes[\"resume_str\"])\njob_tfidf = tfidf.transform(job_df[\"descriptions\"])\n\n# =====================================================\n# 2. BERT EMBEDDINGS\n# =====================================================\nprint(\"Encoding job descriptions (BERT)...\")\njob_bert = get_embeddings(job_df[\"descriptions\"].tolist())\n\nprint(\"Encoding test resumes (BERT)...\")\ntest_bert = get_embeddings(test_resumes[\"resume_str\"].tolist())\n\n# =====================================================\n# 3. CATEGORY INDICES\n# =====================================================\njob_categories = job_df[\"mapped_category\"].values\nunique_categories = sorted(np.unique(job_categories))\n\ncategory_indices = {\n    cat: np.where(job_categories == cat)[0]\n    for cat in unique_categories\n}\n\n# =====================================================\n# 4. HYBRID ALPHA TUNING\n# =====================================================\nalphas = np.linspace(0.0, 1.0, 11)\nresults = []\n\nprint(\"\\nStarting Hybrid Alpha Tuning...\\n\")\n\nfor alpha in alphas:\n    predictions = []\n\n    for i in range(len(test_resumes)):\n        tfidf_sim = cosine_similarity(test_tfidf[i], job_tfidf).flatten()\n        bert_sim = cosine_similarity(test_bert[i].reshape(1, -1), job_bert).flatten()\n\n        # Normalize similarities\n        tfidf_sim = (tfidf_sim - tfidf_sim.min()) / (tfidf_sim.max() - tfidf_sim.min() + 1e-9)\n        bert_sim = (bert_sim - bert_sim.min()) / (bert_sim.max() - bert_sim.min() + 1e-9)\n\n        # Compute per-category scores\n        category_scores = {}\n        for cat in unique_categories:\n            indices = category_indices[cat]\n            lexical_score = tfidf_sim[indices].mean()\n            semantic_score = bert_sim[indices].mean()\n            category_scores[cat] = alpha * semantic_score + (1 - alpha) * lexical_score\n\n        # Pick highest scoring category\n        pred = max(category_scores, key=category_scores.get)\n        predictions.append(pred)\n\n    acc = accuracy_score(test_resumes[\"category\"], predictions)\n    f1 = f1_score(test_resumes[\"category\"], predictions, average=\"macro\")\n\n    results.append((alpha, acc, f1))\n    print(f\"Alpha: {alpha:.2f} | Accuracy: {acc:.4f} | Macro-F1: {f1:.4f}\")\n\n# =====================================================\n# 5. SAVE RESULTS\n# =====================================================\nresults_df = pd.DataFrame(results, columns=[\"Alpha\", \"Accuracy\", \"Macro_F1\"])\nresults_df.to_csv(\"hybrid_alpha_logs.csv\", index=False)\nprint(\"\\nHybrid training logs saved as hybrid_alpha_logs.csv\")\n\n# =====================================================\n# 6. PLOTS\n# =====================================================\nplt.figure()\nplt.plot(results_df[\"Alpha\"], results_df[\"Accuracy\"], marker='o')\nplt.title(\"Hybrid Model Accuracy vs Alpha\")\nplt.xlabel(\"Alpha (Semantic Weight)\")\nplt.ylabel(\"Accuracy\")\nplt.grid(True)\nplt.show()\n\nplt.figure()\nplt.plot(results_df[\"Alpha\"], results_df[\"Macro_F1\"], marker='o')\nplt.title(\"Hybrid Model Macro-F1 vs Alpha\")\nplt.xlabel(\"Alpha (Semantic Weight)\")\nplt.ylabel(\"Macro F1\")\nplt.grid(True)\nplt.show()\n\n# =====================================================\n# 7. BEST ALPHA PREDICTIONS\n# =====================================================\nbest_alpha = results_df.loc[results_df[\"Macro_F1\"].idxmax(), \"Alpha\"]\nprint(\"\\nBest Alpha:\", best_alpha)\n\nfinal_predictions = []\nfor i in range(len(test_resumes)):\n    tfidf_sim = cosine_similarity(test_tfidf[i], job_tfidf).flatten()\n    bert_sim = cosine_similarity(test_bert[i].reshape(1, -1), job_bert).flatten()\n\n    tfidf_sim = (tfidf_sim - tfidf_sim.min()) / (tfidf_sim.max() - tfidf_sim.min() + 1e-9)\n    bert_sim = (bert_sim - bert_sim.min()) / (bert_sim.max() - bert_sim.min() + 1e-9)\n\n    category_scores = {}\n    for cat in unique_categories:\n        indices = category_indices[cat]\n        lexical_score = tfidf_sim[indices].mean()\n        semantic_score = bert_sim[indices].mean()\n        category_scores[cat] = best_alpha * semantic_score + (1 - best_alpha) * lexical_score\n\n    pred = max(category_scores, key=category_scores.get)\n    final_predictions.append(pred)\n\n# =====================================================\n# 8. CONFUSION MATRIX\n# =====================================================\ncm = confusion_matrix(test_resumes[\"category\"], final_predictions, labels=unique_categories)\nplt.figure(figsize=(10,8))\nsns.heatmap(cm, annot=True, fmt=\"d\", xticklabels=unique_categories, yticklabels=unique_categories, cmap=\"Blues\")\nplt.title(\"Confusion Matrix - Hybrid Model\")\nplt.xlabel(\"Predicted\")\nplt.ylabel(\"Actual\")\nplt.show()\n\n# =====================================================\n# 9. PER-CLASS F1\n# =====================================================\nreport = classification_report(test_resumes[\"category\"], final_predictions, output_dict=True)\nclass_f1 = {k: v[\"f1-score\"] for k, v in report.items() if k in unique_categories}\n\nplt.figure(figsize=(12,5))\nplt.bar(class_f1.keys(), class_f1.values())\nplt.xticks(rotation=90)\nplt.title(\"Per-Class F1 Scores - Hybrid Model\")\nplt.ylabel(\"F1 Score\")\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T06:58:56.924965Z","iopub.execute_input":"2026-06-15T06:58:56.925298Z","iopub.status.idle":"2026-06-15T07:43:28.432885Z","shell.execute_reply.started":"2026-06-15T06:58:56.925274Z","shell.execute_reply":"2026-06-15T07:43:28.432244Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Encoding job descriptions (BERT)...\nEncoding test resumes (BERT)...\n\nStarting Hybrid Alpha Tuning...\n\nAlpha: 0.00 | Accuracy: 0.4920 | Macro-F1: 0.4426\nAlpha: 0.10 | Accuracy: 0.5053 | Macro-F1: 0.4616\nAlpha: 0.20 | Accuracy: 0.5186 | Macro-F1: 0.4779\nAlpha: 0.30 | Accuracy: 0.5239 | Macro-F1: 0.4848\nAlpha: 0.40 | Accuracy: 0.5239 | Macro-F1: 0.4903\nAlpha: 0.50 | Accuracy: 0.5293 | Macro-F1: 0.4947\nAlpha: 0.60 | Accuracy: 0.5372 | Macro-F1: 0.5025\nAlpha: 0.70 | Accuracy: 0.5319 | Macro-F1: 0.5020\nAlpha: 0.80 | Accuracy: 0.5293 | Macro-F1: 0.5029\nAlpha: 0.90 | Accuracy: 0.5399 | Macro-F1: 0.5158\nAlpha: 1.00 | Accuracy: 0.5266 | Macro-F1: 0.5011\n\nHybrid training logs saved as hybrid_alpha_logs.csv\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nBest Alpha: 0.9\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":28},{"cell_type":"code","source":"import torch\nimport numpy as np\nimport pandas as pd\nimport pickle\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.utils.class_weight import compute_class_weight\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report\n\nfrom transformers import (\n    AutoTokenizer,\n    AutoModelForSequenceClassification,\n    Trainer,\n    TrainingArguments\n)\n\nfrom datasets import Dataset\n\n# =====================================\n# LOAD DATA\n# =====================================\n\nresume_df = pd.read_csv(\"clean_resumes.csv\")\n\nresume_df.columns = resume_df.columns.str.lower()\n\nresume_df[\"resume_str\"] = (\n    resume_df[\"resume_str\"]\n    .fillna(\"\")\n    .astype(str)\n)\n\nlabel_encoder = LabelEncoder()\n\nresume_df[\"label\"] = label_encoder.fit_transform(\n    resume_df[\"category\"]\n)\n\nnum_labels = len(\n    label_encoder.classes_\n)\n\ntrain_df, test_df = train_test_split(\n    resume_df,\n    test_size=0.20,\n    stratify=resume_df[\"label\"],\n    random_state=42\n)\n\n# =====================================\n# TOKENIZATION\n# =====================================\n\ndevice = torch.device(\n    \"cuda\" if torch.cuda.is_available()\n    else \"cpu\"\n)\n\nMODEL_NAME = \"distilbert-base-uncased\"\n\ntokenizer = AutoTokenizer.from_pretrained(\n    MODEL_NAME\n)\n\ndef tokenize(batch):\n    return tokenizer(\n        batch[\"resume_str\"],\n        padding=\"max_length\",\n        truncation=True,\n        max_length=256\n    )\n\ntrain_dataset = Dataset.from_pandas(\n    train_df\n)\n\ntest_dataset = Dataset.from_pandas(\n    test_df\n)\n\ntrain_dataset = train_dataset.map(\n    tokenize,\n    batched=True\n)\n\ntest_dataset = test_dataset.map(\n    tokenize,\n    batched=True\n)\n\ntrain_dataset = train_dataset.rename_column(\n    \"label\",\n    \"labels\"\n)\n\ntest_dataset = test_dataset.rename_column(\n    \"label\",\n    \"labels\"\n)\n\ntrain_dataset.set_format(\n    \"torch\",\n    columns=[\n        \"input_ids\",\n        \"attention_mask\",\n        \"labels\"\n    ]\n)\n\ntest_dataset.set_format(\n    \"torch\",\n    columns=[\n        \"input_ids\",\n        \"attention_mask\",\n        \"labels\"\n    ]\n)\n\n# =====================================\n# CLASS WEIGHTS\n# =====================================\n\nclass_weights = compute_class_weight(\n    class_weight=\"balanced\",\n    classes=np.unique(train_df[\"label\"]),\n    y=train_df[\"label\"]\n)\n\nclass_weights = torch.tensor(\n    class_weights,\n    dtype=torch.float\n)\n\n# =====================================\n# MODEL\n# =====================================\n\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    MODEL_NAME,\n    num_labels=num_labels\n).to(device)\n\n# =====================================\n# TRAINER\n# =====================================\n\nclass WeightedTrainer(Trainer):\n\n    def compute_loss(\n        self,\n        model,\n        inputs,\n        return_outputs=False,\n        **kwargs\n    ):\n\n        labels = inputs.get(\"labels\")\n\n        outputs = model(**inputs)\n\n        logits = outputs.get(\"logits\")\n\n        loss_fct = torch.nn.CrossEntropyLoss(\n            weight=class_weights.to(\n                logits.device\n            )\n        )\n\n        loss = loss_fct(\n            logits,\n            labels\n        )\n\n        return (\n            (loss, outputs)\n            if return_outputs\n            else loss\n        )\n\ntraining_args = TrainingArguments(\n    output_dir=\"./distilbert_resume_classifier\",\n    learning_rate=2e-5,\n    per_device_train_batch_size=16,\n    per_device_eval_batch_size=32,\n    num_train_epochs=3,\n    weight_decay=0.01,\n    eval_strategy=\"epoch\",\n    save_strategy=\"no\",\n    fp16=True,\n    report_to=\"none\"\n)\n\ndef compute_metrics(eval_pred):\n\n    logits, labels = eval_pred\n\n    preds = np.argmax(\n        logits,\n        axis=1\n    )\n\n    return {\n        \"accuracy\":\n            accuracy_score(\n                labels,\n                preds\n            ),\n        \"macro_f1\":\n            f1_score(\n                labels,\n                preds,\n                average=\"macro\"\n            )\n    }\n\ntrainer = WeightedTrainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_dataset,\n    eval_dataset=test_dataset,\n    compute_metrics=compute_metrics\n)\n\ntrainer.train()\n\n# =====================================\n# PREDICTIONS\n# =====================================\n\npredictions = trainer.predict(\n    test_dataset\n)\n\ndistilbert_preds = np.argmax(\n    predictions.predictions,\n    axis=1\n)\n\ntrue_labels = predictions.label_ids\n\nprint(\n    classification_report(\n        true_labels,\n        distilbert_preds,\n        target_names=\n        label_encoder.classes_\n    )\n)\n\n# =====================================\n# SAVE EVERYTHING\n# =====================================\n\nmodel.save_pretrained(\n    \"saved_distilbert\"\n)\n\ntokenizer.save_pretrained(\n    \"saved_distilbert\"\n)\n\nwith open(\n    \"label_encoder.pkl\",\n    \"wb\"\n) as f:\n    pickle.dump(\n        label_encoder,\n        f\n    )\n\ntrain_df.to_csv(\n    \"train_df.csv\",\n    index=False\n)\n\ntest_df.to_csv(\n    \"test_df.csv\",\n    index=False\n)\n\nnp.save(\n    \"distilbert_preds.npy\",\n    distilbert_preds\n)\n\nnp.save(\n    \"true_labels.npy\",\n    true_labels\n)\n\nnp.save(\n    \"distilbert_logits.npy\",\n    predictions.predictions\n)\n\nprint(\"DistilBERT saved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-15T07:43:28.434255Z","iopub.execute_input":"2026-06-15T07:43:28.434579Z","iopub.status.idle":"2026-06-15T07:44:49.836023Z","shell.execute_reply.started":"2026-06-15T07:43:28.434556Z","shell.execute_reply":"2026-06-15T07:44:49.835198Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/483 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c1ac2f5b4d794b25a5730b322b2bce50"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/48.0 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f54c5da5f2ab4e4c8ca2f94095beb18b"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8b14f3cd5eee4e5c9c5c1630f50a4cee"}},"metadata":{}},{"output_type":"display_data","data":