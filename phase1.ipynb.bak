gure()\nplt.hist(resume_df[\"resume_length\"], bins=50, alpha=0.5)\nplt.hist(job_df[\"job_length\"], bins=50, alpha=0.5)\nplt.title(\"Resume vs Job Description Length Comparison\")\nplt.xlabel(\"Word Count\")\nplt.ylabel(\"Frequency\")\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:19.478276Z","iopub.execute_input":"2026-06-15T05:53:19.478818Z","iopub.status.idle":"2026-06-15T05:53:19.694565Z","shell.execute_reply.started":"2026-06-15T05:53:19.478792Z","shell.execute_reply":"2026-06-15T05:53:19.693679Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":21},{"cell_type":"code","source":"resume_counts = resume_df[\"Category\"].value_counts()\nimbalance_ratio = resume_counts.max() / resume_counts.min()\n\nprint(\"Class Imbalance Ratio (Resumes):\", imbalance_ratio)\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:19.695674Z","iopub.execute_input":"2026-06-15T05:53:19.696379Z","iopub.status.idle":"2026-06-15T05:53:19.701507Z","shell.execute_reply.started":"2026-06-15T05:53:19.696354Z","shell.execute_reply":"2026-06-15T05:53:19.700672Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Class Imbalance Ratio (Resumes): 1.9047619047619047\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report\nfrom sklearn.model_selection import train_test_split\nimport matplotlib.pyplot as plt\nfrom sklearn.metrics import confusion_matrix\n\n# -----------------------------\n# 1. Load cleaned datasets\n# -----------------------------\nresume_df = pd.read_csv(\"clean_resumes.csv\")\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\n\nresume_df.columns = resume_df.columns.str.lower()\njob_df.columns = job_df.columns.str.lower()\n\n# -----------------------------\n# 2. Train/Test Split\n# -----------------------------\ntrain_resumes, test_resumes = train_test_split(\n    resume_df,\n    test_size=0.2,\n    stratify=resume_df[\"category\"],\n    random_state=42\n)\n\n# -----------------------------\n# 3. Fit TF-IDF ONLY to extract keywords\n# -----------------------------\ntfidf = TfidfVectorizer(\n    max_features=5000,\n    stop_words='english',\n    ngram_range=(1,2)\n)\n\ncombined_corpus = list(train_resumes[\"resume_str\"]) + list(job_df[\"descriptions\"])\ntfidf.fit(combined_corpus)\n\nfeature_names = np.array(tfidf.get_feature_names_out())\n\n# -----------------------------\n# 4. Extract Top-K Keywords Function\n# -----------------------------\ndef extract_keywords(text, top_k=20):\n    vec = tfidf.transform([text])\n    scores = vec.toarray().flatten()\n    top_indices = scores.argsort()[-top_k:]\n    return set(feature_names[top_indices])\n\n# Precompute job keywords\njob_keywords = [\n    extract_keywords(desc, top_k=20)\n    for desc in job_df[\"descriptions\"]\n]\n\njob_categories = job_df[\"mapped_category\"].values\nunique_categories = sorted(job_df[\"mapped_category\"].unique())\n\n# Group job indices by category\ncategory_indices = {\n    cat: np.where(job_categories == cat)[0]\n    for cat in unique_categories\n}\n\n# -----------------------------\n# 5. Keyword Matching Prediction\n# -----------------------------\ndef predict_category(resume_text):\n    resume_kw = extract_keywords(resume_text, top_k=20)\n    \n    category_scores = {}\n    \n    for cat in unique_categories:\n        indices = category_indices[cat]\n        overlaps = []\n        \n        for idx in indices:\n            jd_kw = job_keywords[idx]\n            overlap_score = len(resume_kw.intersection(jd_kw)) / (len(resume_kw) + 1e-9)\n            overlaps.append(overlap_score)\n        \n        category_scores[cat] = np.mean(overlaps)\n    \n    return max(category_scores, key=category_scores.get)\n\n# -----------------------------\n# 6. Predict on Test Set\n# -----------------------------\npredictions = []\n\nfor text in test_resumes[\"resume_str\"]:\n    pred = predict_category(text)\n    predictions.append(pred)\n\n# -----------------------------\n# 7. Evaluation\n# -----------------------------\naccuracy = accuracy_score(test_resumes[\"category\"], predictions)\nmacro_f1 = f1_score(test_resumes[\"category\"], predictions, average=\"macro\")\n\nprint(\"Pure Keyword Matching Baseline\")\nprint(\"Accuracy:\", round(accuracy, 4))\nprint(\"Macro F1:\", round(macro_f1, 4))\n\nprint(\"\\nClassification Report:\")\nprint(classification_report(test_resumes[\"category\"], predictions))\n\n# ---------------------------------\n# 8. Confusion Matrix\n# ---------------------------------\ncm = confusion_matrix(\n    test_resumes[\"category\"],\n    predictions,\n    labels=unique_categories\n)\n\nplt.figure(figsize=(10,8))\nplt.imshow(cm)\nplt.title(\"Confusion Matrix - Keyword Matching\")\nplt.colorbar()\nplt.xticks(range(len(unique_categories)), unique_categories, rotation=90)\nplt.yticks(range(len(unique_categories)), unique_categories)\nplt.xlabel(\"Predicted\")\nplt.ylabel(\"Actual\")\nplt.show()\n\n# ---------------------------------\n# 9. Per-Class F1 Plot\n# ---------------------------------\nreport = classification_report(\n    test_resumes[\"category\"],\n    predictions,\n    output_dict=True\n)\n\nclass_f1 = {\n    label: report[label][\"f1-score\"]\n    for label in unique_categories\n}\n\nplt.figure()\nplt.bar(class_f1.keys(), class_f1.values())\nplt.xticks(rotation=90)\nplt.title(\"Per-Class F1 Scores - Keyword Matching\")\nplt.ylabel(\"F1 Score\")\nplt.show()\n\n# ---------------------------------\n# 10. Top-K Sensitivity Analysis\n# ---------------------------------\nk_values = [5, 10, 20, 30, 40]\nk_results = []\n\nfor k in k_values:\n    job_keywords_k = [\n        extract_keywords(desc, top_k=k)\n        for desc in job_df[\"descriptions\"]\n    ]\n    \n    preds_k = []\n    \n    for text in test_resumes[\"resume_str\"]:\n        resume_kw = extract_keywords(text, top_k=k)\n        category_scores = {}\n        \n        for cat in unique_categories:\n            indices = category_indices[cat]\n            overlaps = []\n            \n            for idx in indices:\n                jd_kw = job_keywords_k[idx]\n                overlap_score = len(resume_kw.intersection(jd_kw)) / (len(resume_kw) + 1e-9)\n                overlaps.append(overlap_score)\n            \n            category_scores[cat] = np.mean(overlaps)\n        \n        preds_k.append(max(category_scores, key=category_scores.get))\n    \n    acc_k = accuracy_score(test_resumes[\"category\"], preds_k)\n    f1_k = f1_score(test_resumes[\"category\"], preds_k, average=\"macro\")\n    \n    k_results.append((k, acc_k, f1_k))\n\nk_df = pd.DataFrame(k_results, columns=[\"Top_K\", \"Accuracy\", \"Macro_F1\"])\n\n# Plot Accuracy vs K\nplt.figure()\nplt.plot(k_df[\"Top_K\"], k_df[\"Accuracy\"])\nplt.title(\"Keyword Matching Accuracy vs Top-K\")\nplt.xlabel(\"Top-K Keywords\")\nplt.ylabel(\"Accuracy\")\nplt.show()\n\n# Plot Macro-F1 vs K\nplt.figure()\nplt.plot(k_df[\"Top_K\"], k_df[\"Macro_F1\"])\nplt.title(\"Keyword Matching Macro-F1 vs Top-K\")\nplt.xlabel(\"Top-K Keywords\")\nplt.ylabel(\"Macro F1\")\nplt.show()\n\nprint(\"\\nKeyword Top-K Sensitivity Results:\")\nprint(k_df)\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T05:53:19.702580Z","iopub.execute_input":"2026-06-15T05:53:19.702875Z","iopub.status.idle":"2026-06-15T06:00:44.011219Z","shell.execute_reply.started":"2026-06-15T05:53:19.702852Z","shell.execute_reply":"2026-06-15T06:00:44.010387Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Pure Keyword Matching Baseline\nAccuracy: 0.4867\nMacro F1: 0.4255\n\nClassification Report:\n                        precision    recall  f1-score   support\n\n            ACCOUNTANT       0.51      0.83      0.63        24\n              ADVOCATE       0.00      0.00      0.00        24\n           AGRICULTURE       0.00      0.00      0.00        13\n               BANKING       0.71      0.22      0.33        23\n  BUSINESS-DEVELOPMENT       0.06      0.04      0.05        24\n          CONSTRUCTION       0.48      0.68      0.57        22\n            CONSULTANT       0.12      0.04      0.06        23\n              DESIGNER       0.65      0.71      0.68        21\n         DIGITAL-MEDIA       0.65      0.89      0.76        19\n           ENGINEERING       0.82      0.58      0.68        24\n               FINANCE       0.00      0.00      0.00        24\n               FITNESS       1.00      0.30      0.47        23\n            HEALTHCARE       0.42      0.57      0.48        23\n                    HR       0.78      0.95      0.86        22\nINFORMATION-TECHNOLOGY       0.61      0.58      0.60        24\n                 SALES       0.30      0.87      0.45        23\n               TEACHER       0.44      1.00      0.62        20\n\n              accuracy                           0.49       376\n             macro avg       0.45      0.49      0.43       376\n          weighted avg       0.45      0.49      0.43       376\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nKeyword Top-K Sensitivity Results:\n   Top_K  Accuracy  Macro_F1\n0      5  0.446809  0.409033\n1     10  0.462766  0.409734\n2     20  0.486702  0.425515\n3     30  0.468085  0.422002\n4     40  0.478723  0.433348\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.metrics import accuracy_score, f1_score\nfrom sklearn.model_selection import train_test_split\nimport matplotlib.pyplot as plt\nfrom sklearn.metrics import confusion_matrix, classification_report\n\n# -----------------------------\n# 1. Load cleaned datasets\n# -----------------------------\nresume_df = pd.read_csv(\"clean_resumes.csv\")\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\n\n# Standardize column names if needed\nresume_df.columns = resume_df.columns.str.lower()\njob_df.columns = job_df.columns.str.lower()\n\n# -----------------------------\n# 2. Train/Test Split (Resumes)\n# -----------------------------\ntrain_resumes, test_resumes = train_test_split(\n    resume_df,\n    test_size=0.2,\n    stratify=resume_df[\"category\"],\n    random_state=42\n)\n\n# -----------------------------\n# 3. Fit TF-IDF on TRAIN resumes + ALL job descriptions\n# -----------------------------\ntfidf = TfidfVectorizer(\n    max_features=5000,\n    stop_words='english',\n    ngram_range=(1,2)\n)\n\ncombined_corpus = list(train_resumes[\"resume_str\"]) + list(job_df[\"descriptions\"])\ntfidf.fit(combined_corpus)\n\n# Transform\ntrain_resume_vectors = tfidf.transform(train_resumes[\"resume_str\"])\ntest_resume_vectors = tfidf.transform(test_resumes[\"resume_str\"])\njob_vectors = tfidf.transform(job_df[\"descriptions\"])\n\n# -----------------------------\n# 4. Precompute Job Category Groups\n# -----------------------------\njob_categories = job_df[\"mapped_category\"].values\nunique_categories = sorted(job_df[\"mapped_category\"].unique())\n\n# For faster indexing\ncategory_indices = {\n    cat: np.where(job_categories == cat)[0]\n    for cat in unique_categories\n}\n\n# -----------------------------\n# 5. Prediction Function\n# -----------------------------\ndef predict_category(resume_vector):\n    similarities = cosine_similarity(resume_vector, job_vectors).flatten()\n    \n    category_scores = {}\n    \n    for cat in unique_categories:\n        indices = category_indices[cat]\n        category_scores[cat] = similarities[indices].mean()\n    \n    return max(category_scores, key=category_scores.get)\n\n# -----------------------------\n# 6. Predict on Test Set\n# -----------------------------\npredictions = []\n\nfor i in range(test_resume_vectors.shape[0]):\n    pred = predict_category(test_resume_vectors[i])\n    predictions.append(pred)\n\n# -----------------------------\n# 7. Evaluation\n# -----------------------------\naccuracy = accuracy_score(test_resumes[\"category\"], predictions)\nmacro_f1 = f1_score(test_resumes[\"category\"], predictions, average=\"macro\")\n\nprint(\"TF-IDF + Cosine Similarity Baseline\")\nprint(\"Accuracy:\", round(accuracy, 4))\nprint(\"Macro F1:\", round(macro_f1, 4))\n\n# ---------------------------------\n# 8. Confusion Matrix\n# ---------------------------------\ncm = confusion_matrix(\n    test_resumes[\"category\"],\n    predictions,\n    labels=unique_categories\n)\n\nplt.figure(figsize=(10,8))\nplt.imshow(cm)\nplt.title(\"Confusion Matrix - TF-IDF Matching\")\nplt.colorbar()\nplt.xticks(range(len(unique_categories)), unique_categories, rotation=90)\nplt.yticks(range(len(unique_categories)), unique_categories)\nplt.xlabel(\"Predicted\")\nplt.ylabel(\"Actual\")\nplt.show()\n\n# ---------------------------------\n# 9. Per-Class F1 Plot\n# ---------------------------------\nreport = classification_report(\n    test_resumes[\"category\"],\n    predictions,\n    output_dict=True\n)\n\nclass_f1 = {\n    label: report[label][\"f1-score\"]\n    for label in unique_categories\n}\n\nplt.figure()\nplt.bar(class_f1.keys(), class_f1.values())\nplt.xticks(rotation=90)\nplt.title(\"Per-Class F1 Scores - TF-IDF Matching\")\nplt.ylabel(\"F1 Score\")\nplt.show()\n\n# ---------------------------------\n# 10. Vocabulary Size Sensitivity\n# ---------------------------------\nfeature_sizes = [1000, 3000, 5000, 8000]\nsweep_results = []\n\nfor size in feature_sizes:\n    tfidf_sweep = TfidfVectorizer(\n        max_features=size,\n        stop_words='english',\n        ngram_range=(1,2)\n    )\n    \n    tfidf_sweep.fit(combined_corpus)\n    \n    test_vec = tfidf_sweep.transform(test_resumes[\"resume_str\"])\n    job_vec = tfidf_sweep.transform(job_df[\"descriptions\"])\n    \n    preds = []\n    \n    for i in range(test_vec.shape[0]):\n        sims = cosine_similarity(test_vec[i], job_vec).flatten()\n        category_scores = {}\n        \n        for cat in unique_categories:\n            indices = category_indices[cat]\n            category_scores[cat] = sims[indices].mean()\n        \n        preds.append(max(category_scores, key=category_scores.get))\n    \n    acc = accuracy_score(test_resumes[\"category\"], preds)\n    f1 = f1_score(test_resumes[\"category\"], preds, average=\"macro\")\n    \n    sweep_results.append((size, acc, f1))\n\nsweep_df = pd.DataFrame(sweep_results, columns=[\"Vocab_Size\", \"Accuracy\", \"Macro_F1\"])\n\n# Accuracy vs Vocabulary Size\nplt.figure()\nplt.plot(sweep_df[\"Vocab_Size\"], sweep_df[\"Accuracy\"])\nplt.title(\"TF-IDF Accuracy vs Vocabulary Size\")\nplt.xlabel(\"Max Features\")\nplt.ylabel(\"Accuracy\")\nplt.show()\n\n# Macro-F1 vs Vocabulary Size\nplt.figure()\nplt.plot(sweep_df[\"Vocab_Size\"], sweep_df[\"Macro_F1\"])\nplt.title(\"TF-IDF Macro-F1 vs Vocabulary Size\")\nplt.xlabel(\"Max Features\")\nplt.ylabel(\"Macro F1\")\nplt.show()\n\nprint(\"\\nVocabulary Sensitivity Results:\")\nprint(sweep_df)\n\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T06:00:44.012391Z","iopub.execute_input":"2026-06-15T06:00:44.012684Z","iopub.status.idle":"2026-06-15T06:08:39.683499Z","shell.execute_reply.started":"2026-06-15T06:00:44.012660Z","shell.execute_reply":"2026-06-15T06:08:39.682707Z"},"trusted":true},"outputs":[{"name":"stdout","text":"TF-IDF + Cosine Similarity Baseline\nAccuracy: 0.492\nMacro F1: 0.4433\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nVocabulary Sensitivity Results:\n   Vocab_Size  Accuracy  Macro_F1\n0        1000  0.476064  0.418689\n1        3000  0.494681  0.439531\n2        5000  0.492021  0.443293\n3        8000  0.492021  0.443897\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"from sklearn.metrics import classification_report\n\nprint(\"\\nClassification Report:\")\nprint(classification_report(test_resumes[\"category\"], predictions))\n\nprint(set(test_resumes[\"category\"]) - set(unique_categories))\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T06:08:39.684765Z","iopub.execute_input":"2026-06-15T06:08:39.685606Z","iopub.status.idle":"2026-06-15T06:08:39.703396Z","shell.execute_reply.started":"2026-06-15T06:08:39.685576Z","shell.execute_reply":"2026-06-15T06:08:39.702688Z"},"trusted":true},"outputs":[{"name":"stdout","text":"\nClassification Report:\n                        precision    recall  f1-score   support\n\n            ACCOUNTANT       0.50      0.88      0.64        24\n              ADVOCATE       0.00      0.00      0.00        24\n           AGRICULTURE       0.50      0.08      0.13        13\n               BANKING       0.67      0.17      0.28        23\n  BUSINESS-DEVELOPMENT       0.08      0.08      0.08        24\n          CONSTRUCTION       0.65      0.68      0.67        22\n            CONSULTANT       0.25      0.09      0.13        23\n              DESIGNER       0.87      0.62      0.72        21\n         DIGITAL-MEDIA       0.67      0.84      0.74        19\n           ENGINEERING       0.79      0.62      0.70        24\n               FINANCE       0.00      0.00      0.00        24\n               FITNESS       1.00      0.35      0.52        23\n            HEALTHCARE       0.43      0.52      0.47        23\n                    HR       0.75      0.95      0.84        22\nINFORMATION-TECHNOLOGY       0.53      0.71      0.61        24\n                 SALES       0.28      0.78      0.41        23\n               TEACHER       0.43      1.00      0.61        20\n\n              accuracy                           0.49       376\n             macro avg       0.49      0.49      0.44       376\n          weighted avg       0.49      0.49      0.44       376\n\nset()\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport torch\nfrom transformers import AutoTokenizer, AutoModel\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report\nfrom sklearn.model_selection import train_test_split\nfrom tqdm import tqdm\nimport matplotlib.pyplot as plt\nfrom sklearn.metrics import confusion_matrix\n\n# -----------------------------\n# 1. Load cleaned datasets\n# -----------------------------\nresume_df = pd.read_csv(\"clean_resumes.csv\")\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\n\nresume_df.columns = resume_df.columns.str.lower()\njob_df.columns = job_df.columns.str.lower()\n\n# -----------------------------\n# 2. Train/Test Split\n# -----------------------------\ntrain_resumes, test_resumes = train_test_split(\n    resume_df,\n    test_size=0.2,\n    stratify=resume_df[\"category\"],\n    random_state=42\n)\n\n# -----------------------------\n# 3. Load Pretrained BERT\n# -----------------------------\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\nmodel = AutoModel.from_pretrained(\"bert-base-uncased\")\nmodel.to(device)\nmodel.eval()\n\n# -----------------------------\n# 4. Sentence Embedding Function (Mean Pooling)\n# -----------------------------\ndef get_embeddings(text_list, batch_size=16):\n    embeddings = []\n    \n    for i in tqdm(range(0, len(text_list), batch_size)):\n        batch = text_list[i:i+batch_size]\n        \n        inputs = tokenizer(\n            batch,\n            padding=True,\n            truncation=True,\n            max_length=256,\n            return_tensors=\"pt\"\n        ).to(device)\n        \n        with torch.no_grad():\n            outputs = model(**inputs)\n        \n        last_hidden = outputs.last_hidden_state\n        \n        # Mean pooling\n        attention_mask = inputs[\"attention_mask\"].unsqueeze(-1)\n        masked_hidden = last_hidden * attention_mask\n        summed = torch.sum(masked_hidden, dim=1)\n        counts = torch.clamp(attention_mask.sum(dim=1), min=1e-9)\n        mean_pooled = summed / counts\n        \n        embeddings.append(mean_pooled.cpu().numpy())\n    \n    return np.vstack(embeddings)\n\n# -----------------------------\n# 5. Compute Embeddings\n# -----------------------------\nprint(\"Encoding job descriptions...\")\njob_embeddings = get_embeddings(job_df[\"descriptions\"].tolist())\n\nprint(\"Encoding test resumes...\")\ntest_resume_embeddings = get_embeddings(test_resumes[\"resume_str\"].tolist())\n\n# -----------------------------\n# 6. Prepare Category Indexing\n# -----------------------------\njob_categories = job_df[\"mapped_category\"].values\nunique_categories = sorted(job_df[\"mapped_category\"].unique())\n\ncategory_indices = {\n    cat: np.where(job_categories == cat)[0]\n    for cat in unique_categories\n}\n\n# -----------------------------\n# 7. Prediction Function\n# -----------------------------\ndef predict_category(resume_embedding):\n    similarities = cosine_similarity(\n        resume_embedding.reshape(1, -1),\n        job_embeddings\n    ).flatten()\n    \n    category_scores = {}\n    \n    for cat in unique_categories:\n        indices = category_indices[cat]\n        category_scores[cat] = similarities[indices].mean()\n    \n    return max(category_scores, key=category_scores.get)\n\n# -----------------------------\n# 8. Predict on Test Set\n# -----------------------------\npredictions = []\n\nfor i in range(len(test_resume_embeddings)):\n    pred = predict_category(test_resume_embeddings[i])\n    predictions.append(pred)\n\n# -----------------------------\n# 9. Evaluation\n# -----------------------------\naccuracy = accuracy_score(test_resumes[\"category\"], predictions)\nmacro_f1 = f1_score(test_resumes[\"category\"], predictions, average=\"macro\")\n\nprint(\"\\nBERT-Only Semantic Matching Baseline\")\nprint(\"Accuracy:\", round(accuracy, 4))\nprint(\"Macro F1:\", round(macro_f1, 4))\n\nprint(\"\\nClassification Report:\")\nprint(classification_report(test_resumes[\"category\"], predictions))\n\n# ---------------------------------\n# 10. Confusion Matrix\n# ---------------------------------\ncm = confusion_matrix(\n    test_resumes[\"category\"],\n    predictions,\n    labels=unique_categories\n)\n\nplt.figure(figsize=(10,8))\nplt.imshow(cm)\nplt.title(\"Confusion Matrix - BERT Semantic Matching\")\nplt.colorbar()\nplt.xticks(range(len(unique_categories)), unique_categories, rotation=90)\nplt.yticks(range(len(unique_categories)), unique_categories)\nplt.xlabel(\"Predicted\")\nplt.ylabel(\"Actual\")\nplt.show()\n\n# ---------------------------------\n# 11. Per-Class F1 Plot\n# ---------------------------------\nreport = classification_report(\n    test_resumes[\"category\"],\n    predictions,\n    output_dict=True\n)\n\nclass_f1 = {\n    label: report[label][\"f1-score\"]\n    for label in unique_categories\n}\n\nplt.figure()\nplt.bar(class_f1.keys(), class_f1.values())\nplt.xticks(rotation=90)\nplt.title(\"Per-Class F1 Scores - BERT Semantic Matching\")\nplt.ylabel(\"F1 Score\")\nplt.show()\n\n# ---------------------------------\n# 12. Similarity Distribution Analysis\n# ---------------------------------\ncorrect_sims = []\nincorrect_sims = []\n\nfor i in range(len(test_resume_embeddings)):\n    sims = cosine_similarity(\n        test_resume_embeddings[i].reshape(1, -1),\n        job_embeddings\n    ).flatten()\n\n    best_idx = np.argmax(sims)\n    predicted_label = job_categories[best_idx]\n    true_label = test_resumes[\"category\"].iloc[i]\n\n    if predicted_label == true_label:\n        correct_sims.append(np.max(sims))\n    else:\n        incorrect_sims.append(np.max(sims))\n\nplt.figure()\nplt.hist(correct_sims, bins=30, alpha=0.5)\nplt.hist(incorrect_sims, bins=30, alpha=0.5)\nplt.title(\"Similarity Score Distribution (Correct vs Incorrect)\")\nplt.xlabel(\"Cosine Similarity\")\nplt.ylabel(\"Frequency\")\nplt.show()\n\n# ---------------------------------\n# 13. Pooling Strategy Comparison\n# ---------------------------------\ndef get_cls_embeddings(text_list, batch_size=16):\n    embeddings = []\n    for i in tqdm(range(0, len(text_list), batch_size)):\n        batch = text_list[i:i+batch_size]\n        inputs = tokenizer(\n            batch,\n            padding=True,\n            truncation=True,\n            max_length=256,\n            return_tensors=\"pt\"\n        ).to(device)\n        with torch.no_grad():\n            outputs = model(**inputs)\n\n        cls_embeddings = outputs.last_hidden_state[:, 0, :]\n        embeddings.append(cls_embeddings.cpu().numpy())\n\n    return np.vstack(embeddings)\n\nprint(\"Encoding with CLS pooling...\")\njob_cls = get_cls_embeddings(job_df[\"descriptions\"].tolist())\ntest_cls = get_cls_embeddings(test_resumes[\"resume_str\"].tolist())\n\ncls_predictions = []\n\nfor i in range(len(test_cls)):\n    sims = cosine_similarity(\n        test_cls[i].reshape(1, -1),\n        job_cls\n    ).flatten()\n\n    category_scores = {}\n    for cat in unique_categories:\n        indices = category_indices[cat]\n        category_scores[cat] = sims[indices].mean()\n\n    cls_predictions.append(max(category_scores, key=category_scores.get))\n\ncls_acc = accuracy_score(test_resumes[\"category\"], cls_predictions)\ncls_f1 = f1_score(test_resumes[\"category\"], cls_predictions, average=\"macro\")\n\n# Plot comparison\nplt.figure()\nplt.bar([\"Mean Pooling\", \"CLS Pooling\"], [accuracy, cls_acc])\nplt.title(\"Pooling Strategy Comparison - BERT\")\nplt.ylabel(\"Accuracy\")\nplt.show()\n\nprint(\"\\nPooling Comparison:\")\nprint(\"Mean Pooling Accuracy:\", round(accuracy, 4))\nprint(\"CLS Pooling Accuracy:\", round(cls_acc, 4))\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T06:08:39.704349Z","iopub.execute_input":"2026-06-15T06:08:39.704742Z","iopub.status.idle":"2026-06-15T06:33:41.215779Z","shell.execute_reply.started":"2026-06-15T06:08:39.704717Z","shell.execute_reply":"2026-06-15T06:33:41.214931Z"},"trusted":true},"outputs":[{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/570 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"a9b5090b3721471aa0b363b412fd7040"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/48.0 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"14ea00c595c540279debc4b69acba2ed"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3fbb254b