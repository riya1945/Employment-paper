e\nAccuracy: 0.2766\nMacro F1: 0.2586\n\nClassification Report:\n                        precision    recall  f1-score   support\n\n            ACCOUNTANT       0.75      0.50      0.60        24\n              ADVOCATE       0.00      0.00      0.00        24\n           AGRICULTURE       1.00      0.08      0.14        13\n               BANKING       0.00      0.00      0.00        23\n  BUSINESS-DEVELOPMENT       0.00      0.00      0.00        24\n          CONSTRUCTION       0.60      0.27      0.38        22\n            CONSULTANT       0.10      0.17      0.12        23\n              DESIGNER       0.65      0.52      0.58        21\n         DIGITAL-MEDIA       0.71      0.26      0.38        19\n           ENGINEERING       0.62      0.21      0.31        24\n               FINANCE       0.11      0.71      0.20        24\n               FITNESS       0.00      0.00      0.00        23\n            HEALTHCARE       0.33      0.13      0.19        23\n                    HR       1.00      0.36      0.53        22\nINFORMATION-TECHNOLOGY       0.31      0.83      0.45        24\n                 SALES       0.26      0.43      0.33        23\n               TEACHER       1.00      0.10      0.18        20\n\n              accuracy                           0.28       376\n             macro avg       0.44      0.27      0.26       376\n          weighted avg       0.41      0.28      0.26       376\n\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.12/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Encoding with CLS pooling...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 2656/2656 [11:14<00:00,  3.94it/s]\n100%|██████████| 24/24 [00:06<00:00,  3.87it/s]\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nPooling Comparison:\nMean Pooling Accuracy: 0.2766\nCLS Pooling Accuracy: 0.242\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport torch\nfrom sentence_transformers import SentenceTransformer\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report, confusion_matrix\nfrom sklearn.model_selection import train_test_split\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\n\n# =====================================================\n# 1. LOAD & CLEAN DATA\n# =====================================================\nresume_df = pd.read_csv(\"clean_resumes.csv\")\njob_df = pd.read_csv(\"clean_job_descriptions.csv\")\n\nresume_df.columns = resume_df.columns.str.lower()\njob_df.columns = job_df.columns.str.lower()\n\n# Clean text fields\nresume_df[\"resume_str\"] = resume_df[\"resume_str\"].fillna(\"\").astype(str)\njob_df[\"descriptions\"] = job_df[\"descriptions\"].fillna(\"\").astype(str)\n\nresume_df = resume_df[resume_df[\"resume_str\"].str.strip() != \"\"]\njob_df = job_df[job_df[\"descriptions\"].str.strip() != \"\"]\n\ntrain_resumes, test_resumes = train_test_split(\n    resume_df,\n    test_size=0.2,\n    stratify=resume_df[\"category\"],\n    random_state=42\n)\n\n# =====================================================\n# 2. LOAD SENTENCE-BERT (OPTIMIZED)\n# =====================================================\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nmodel = SentenceTransformer(\"all-mpnet-base-v2\", device=device)\n\n# =====================================================\n# 3. ROBUST CHUNKING FUNCTION\n# =====================================================\ndef chunk_text(text, chunk_size=400, overlap=50):\n    words = str(text).split()\n    if len(words) == 0:\n        return []\n    step = chunk_size - overlap\n    return [\n        \" \".join(words[i:i+chunk_size])\n        for i in range(0, len(words), step)\n        if len(words[i:i+chunk_size]) > 5\n    ]\n\ndef encode_long_text(text):\n    # Split text into chunks if necessary\n    chunks = chunk_text(text)\n\n    # If no chunks, just encode the full text\n    if len(chunks) == 0:\n        return model.encode(str(text), convert_to_numpy=True)\n\n    # Encode all chunks\n    embeddings = model.encode(chunks, convert_to_numpy=True, show_progress_bar=False)\n\n    # If embeddings is 1D (single chunk), return as is\n    if embeddings.ndim == 1:\n        return embeddings\n\n    # If multiple chunks, return the mean embedding\n    return np.mean(embeddings, axis=0)\n\n\n# =====================================================\n# 4. ENCODE JOB DESCRIPTIONS (ONCE)\n# =====================================================\nprint(\"Encoding job descriptions...\")\njob_embeddings = []\n\nfor desc in tqdm(job_df[\"descriptions\"].tolist()):\n    job_embeddings.append(encode_long_text(desc))\n\njob_embeddings = np.vstack(job_embeddings)\nprint(\"Job Embedding Shape:\", job_embeddings.shape)\n\n# =====================================================\n# 5. CATEGORY INDEXING + CENTROIDS\n# =====================================================\njob_categories = job_df[\"mapped_category\"].values\nunique_categories = sorted(np.unique(job_categories))\n\ncategory_indices = {\n    cat: np.where(job_categories == cat)[0]\n    for cat in unique_categories\n}\n\n# Category centroid embeddings\ncategory_centroids = {}\n\nfor cat in unique_categories:\n    indices = category_indices[cat]\n    category_centroids[cat] = np.mean(job_embeddings[indices], axis=0)\n\n# =====================================================\n# 6. PREDICTION FUNCTION (TOP-K + CENTROID)\n# =====================================================\ndef predict_category(resume_text, top_k=10):\n    resume_embedding = encode_long_text(resume_text)\n    \n    similarities = cosine_similarity(\n        resume_embedding.reshape(1, -1),\n        job_embeddings\n    ).flatten()\n    \n    category_scores = {}\n    \n    for cat in unique_categories:\n        indices = category_indices[cat]\n        \n        # Top-K similarity aggregation\n        top_sim = np.sort(similarities[indices])[-top_k:]\n        topk_score = np.mean(top_sim)\n        \n        # Centroid similarity\n        centroid_sim = cosine_similarity(\n            resume_embedding.reshape(1, -1),\n            category_centroids[cat].reshape(1, -1)\n        )[0][0]\n        \n        # Weighted combination\n        category_scores[cat] = 0.7 * topk_score + 0.3 * centroid_sim\n    \n    return max(category_scores, key=category_scores.get)\n\n# =====================================================\n# 7. EVALUATION\n# =====================================================\nprint(\"Evaluating semantic model...\")\npredictions = []\n\nfor text in tqdm(test_resumes[\"resume_str\"].tolist()):\n    predictions.append(predict_category(text))\n\naccuracy = accuracy_score(test_resumes[\"category\"], predictions)\nmacro_f1 = f1_score(test_resumes[\"category\"], predictions, average=\"macro\")\n\nprint(\"\\nImproved Semantic Matching (Sentence-BERT)\")\nprint(\"Accuracy:\", round(accuracy, 4))\nprint(\"Macro F1:\", round(macro_f1, 4))\nprint(\"\\nClassification Report:\")\nprint(classification_report(test_resumes[\"category\"], predictions))\n\n# =====================================================\n# 8. CONFUSION MATRIX\n# =====================================================\ncm = confusion_matrix(\n    test_resumes[\"category\"],\n    predictions,\n    labels=unique_categories\n)\n\nplt.figure(figsize=(10,8))\nplt.imshow(cm)\nplt.title(\"Confusion Matrix - Improved Semantic Matching\")\nplt.colorbar()\nplt.xticks(range(len(unique_categories)), unique_categories, rotation=90)\nplt.yticks(range(len(unique_categories)), unique_categories)\nplt.xlabel(\"Predicted\")\nplt.ylabel(\"Actual\")\nplt.show()\n\n# =====================================================\n# 9. PER-CLASS F1 PLOT\n# =====================================================\nreport = classification_report(\n    test_resumes[\"category\"],\n    predictions,\n    output_dict=True\n)\n\nclass_f1 = {\n    label: report[label][\"f1-score\"]\n    for label in unique_categories\n}\n\nplt.figure()\nplt.bar(class_f1.keys(), class_f1.values())\nplt.xticks(rotation=90)\nplt.title(\"Per-Class F1 - Improved Semantic Matching\")\nplt.ylabel(\"F1 Score\")\nplt.show()\n","metadata":{"execution":{"iopub.status.busy":"2026-06-15T06:33:41.216996Z","iopub.execute_input":"2026-06-15T06:33:41.217322Z","iopub.status.idle":"2026-06-15T06:58:56.921476Z","shell.execute_reply.started":"2026-06-15T06:33:41.217296Z","shell.execute_reply":"2026-06-15T06:58:56.920807Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"modules.json:   0%|          | 0.00/349 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2015548a46ce4cffb92e7a6b910dd285"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config_sentence_transformers.json:   0%|          | 0.00/116 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"212d218c198c458aa13660f3456c6263"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"README.md: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"664ed53dc739499fbe4d9cd5af65648c"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"sentence_bert_config.json:   0%|          | 0.00/53.0 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c0c69847bc3b4516828d